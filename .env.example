# ──────────────────────────────────────────────────────────────────────────
# LAPS — environment template
#
# Copy this file to `.env` (which is gitignored) and fill in every required
# value. docker compose reads these vars at `up` time and refuses to start
# if anything required is missing — that's by design.
#
# All vars marked REQUIRED have no safe default. Generating the JWT secret:
#   openssl rand -base64 48
# ──────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_NAME=lapsnew
DB_USERNAME=laps
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_VALUE                         # REQUIRED

# Postgres TLS mode. `disable` for the docker-compose dev stack (network is
# internal-only); `require` for any externally-hosted Postgres (Render's
# managed Postgres requires it).
#
# Note what `require` does and does not do: it encrypts the connection but
# performs NO certificate validation, so it defeats passive interception and
# not an active man-in-the-middle. `verify-full` is the mode that authenticates
# the server, and it additionally needs the provider's CA bundle available to
# the JVM (PGSSLROOTCERT / a truststore). Worth doing if the database is
# reached across a network you do not control.
DB_SSLMODE=disable

# Render injects DATABASE_URL automatically when bound to a managed Postgres,
# and docker-compose builds it from DB_NAME against the `laps-db` service.
# Leave blank unless you're targeting an external DB.
DATABASE_URL=

# Only read when DATABASE_URL is blank AND you are running the API outside
# docker-compose (see laps-api/.env.example). Unused in both deployments.
DB_HOST=localhost
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────
# At least 32 characters (HS256). Use `openssl rand -base64 48` to generate.
LAPS_JWT_SECRET=CHANGE_ME_RUN_openssl_rand_-base64_48             # REQUIRED
LAPS_JWT_TTL=PT8H

# ── Authorization ─────────────────────────────────────────────────────────
# Comma-separated emails of users who get the MANAGER role at login. Empty
# means no managers — the admin UI will refuse to load until at least one
# email is whitelisted here.
LAPS_MANAGER_EMAILS=

# ── Bootstrap admin (first boot only) ─────────────────────────────────────
# When all four are set, the api will create this account on first boot
# (or attach a password to it if it already exists with no password). Leave
# blank in steady-state — use the temp-password flow from the admin UI.
LAPS_BOOTSTRAP_EMAIL=
LAPS_BOOTSTRAP_FULL_NAME=
LAPS_BOOTSTRAP_SLUG=
LAPS_BOOTSTRAP_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the api. Because the SPA
# proxies through nginx in the web container, the only "real" origin is the
# production hostname.
LAPS_CORS_ALLOWED_ORIGINS=https://laps.uema.br                    # REQUIRED

# ── Translation provider ──────────────────────────────────────────────────
# `mymemory` sends bios out to a free public translation API — change to
# `none` if that's unacceptable for LGPD purposes.
LAPS_TRANSLATE_PROVIDER=mymemory
LAPS_TRANSLATE_BASE_URL=
LAPS_TRANSLATE_KEY=

# ── Media storage ─────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED IN PRODUCTION.
#
# When all three are set, uploaded photos and banners go to Cloudinary and
# survive redeploys. When any is blank, PhotoUploadService falls back to local
# disk (LAPS_MEDIA_DIR, default ./uploads) and logs a warning at startup.
#
# On Render's free tier that fallback means uploads are DESTROYED on every
# redeploy, restart, or spin-down — while the database keeps pointing at
# /uploads/<uuid>.jpg, leaving permanently broken images. The free plan has no
# persistent disk, so Cloudinary (or a paid Render disk) is the only way to
# keep uploaded photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Asset folder inside the Cloudinary account. Not a secret.
CLOUDINARY_FOLDER=laps

# Local-disk fallback location, used only when the Cloudinary vars above are blank.
LAPS_MEDIA_DIR=./uploads

# ── Rate limiting ─────────────────────────────────────────────────────────
LAPS_RATE_AUTH_PER_MIN=10
LAPS_RATE_AUTH_BLOCK_SECONDS=60

# Number of trailing X-Forwarded-For entries written by infrastructure you
# control. Getting this wrong is not a small error:
#   too low  -> every visitor shares one rate-limit bucket, so one attacker can
#               lock every member out of login, and the per-IP limit is useless
#   too high -> callers can forge the header and mint a fresh bucket per request
#
# 1 is correct for docker-compose, where nginx appends the peer address with
# $proxy_add_x_forwarded_for. Render has no nginx, so CHECK IT THERE:
#   1. from one machine, POST /api/v1/auth/login with a wrong password 11 times
#      -> you should get 429 on the 11th
#   2. immediately try a valid login from a different network (phone on mobile
#      data). If that is ALSO 429, the buckets are shared -> raise this to 2
#      and repeat. If it succeeds, the value is right.
# The per-account limit works regardless of this setting, so a wrong value
# degrades protection rather than removing it.
LAPS_TRUSTED_PROXY_HOPS=1

# ── Bot protection (proof of work) ────────────────────────────────────────
# Login, set-password and invite registration require the browser to solve a
# server-issued hash puzzle first. No third party is involved and no visitor
# data leaves UEMA, which is why this was chosen over a captcha — but it is a
# cost, not an identity check, so it slows automation rather than stopping it.
#
# Leading zero bits required. Each +1 DOUBLES the work: 16 is ~0.2s on a
# laptop, 18 ~0.8s, 20 ~3s. Raise it if you see automated login pressure;
# remember the cost lands on every real member's login too. Clamped to 8..24.
LAPS_POW_DIFFICULTY_BITS=16

# How long an unspent challenge stays valid. Challenges are single-use — spent
# on presentation whether or not the credentials were correct — so this only
# bounds how long a solved-but-unsubmitted one survives.
LAPS_POW_TTL=PT5M

# ── Session cookie ────────────────────────────────────────────────────────
# Forces the Secure flag on the session cookie regardless of what the request
# looks like. Leave BLANK only if you serve this over plain HTTP — a Secure
# cookie on an http:// origin is discarded by the browser and login silently
# stops working. Both documented deployments should set this to true.
LAPS_COOKIE_SECURE=true

# ── App ───────────────────────────────────────────────────────────────────
# Host port the monolith listens on. Spring Boot binds to 8080 inside the
# container; this maps it to whatever you want on the host.
APP_HOST_PORT=8080

# Build-time API base for the SPA. Empty = same-origin (recommended — keeps
# cookies sane). Set to an absolute URL only if you split api + web hosts.
#
# This is the ONLY variable that is compiled into the browser bundle. Never
# put a credential in a VITE_-prefixed variable: Vite inlines them verbatim
# into the published JavaScript, where anyone can read them.
VITE_API_BASE=

# ── Runtime knobs (both deployments set these for you) ───────────────────
# docker-compose.yml pins SPRING_PROFILES_ACTIVE=prod and render.yaml sets it
# in the blueprint; listed here so the full set of variables the app reads is
# documented in one place. Override only if you are running the jar directly.
#
# `prod` enables application-prod.yml: proxy header handling, sslmode=require
# by default, and a REQUIRED LAPS_CORS_ALLOWED_ORIGINS with no fallback.
SPRING_PROFILES_ACTIVE=prod

# Port Spring Boot binds inside the container. Render overrides this via PORT;
# compose maps it to APP_HOST_PORT above.
SERVER_PORT=8080

# Log levels. Keep JDBC at WARN outside of debugging sessions — DEBUG makes
# Hibernate echo statements and bound parameters, which is member data.
LOG_LEVEL_APP=INFO
LOG_LEVEL_JDBC=WARN
