{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd laps-signal-lab && npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "cd laps-signal-lab && npm run build",
  "outputDirectory": "laps-signal-lab/dist/client",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
