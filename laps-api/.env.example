# ──────────────────────────────────────────────────────────────────────────
# laps-api — environment template for running the API MODULE ON ITS OWN
# (`mvn spring-boot:run` from this directory; application.yml imports
# `optional:file:.env[.properties]` at startup).
#
# For the full stack — docker compose, or the Render monolith — use the
# template at the repository root instead: ../.env.example. That file is the
# canonical list; this one covers only what the API process itself reads.
#
# Copy to `.env` (gitignored) and fill in every value marked REQUIRED.
# ──────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Used only when DATABASE_URL is unset — application.yml composes the JDBC
# URL from these. Postgres, not MySQL: the default port is 5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lapsnew
DB_USERNAME=postgres
DB_PASSWORD=                                                       # REQUIRED

# `disable` for a local Postgres on loopback; `require` for anything hosted.
DB_SSLMODE=disable

# Set this INSTEAD of the DB_* vars above to point at an external database.
# Accepts either a jdbc: URL or Render's postgresql://user:pass@host/db form.
DATABASE_URL=

# ── JWT ───────────────────────────────────────────────────────────────────
# At least 32 characters (HS256). Generate with: openssl rand -base64 48
# The app refuses to start without it, by design.
LAPS_JWT_SECRET=                                                   # REQUIRED
LAPS_JWT_TTL=PT8H

# ── Authorization ─────────────────────────────────────────────────────────
# Comma-separated emails that receive the MANAGER role at login. Empty means
# nobody can reach /api/v1/admin/** — the admin UI will not load.
LAPS_MANAGER_EMAILS=

# ── Bootstrap admin (first boot only) ─────────────────────────────────────
# All four must be set for the account to be provisioned. Leave blank in
# steady state and use the admin UI's reset-password flow instead.
LAPS_BOOTSTRAP_EMAIL=
LAPS_BOOTSTRAP_FULL_NAME=
LAPS_BOOTSTRAP_SLUG=
LAPS_BOOTSTRAP_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origin patterns. Needed when the SPA runs on the Vite dev
# server (:5173) and calls this API on :8080 — that is cross-origin.
# Never set this to `*`: credentials are allowed on this endpoint.
LAPS_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ── Media storage ─────────────────────────────────────────────────────────
# All three set → uploads go to Cloudinary. Any blank → local-disk fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=laps
LAPS_MEDIA_DIR=./uploads

# ── Transactional email (verification codes) ──────────────────────────────
# Blank provider = nothing is sent and the portal shows the code on screen.
# `brevo` (300/day free, sender authorised by email, no DNS needed) or
# `resend` (3000/month free, requires a DNS-verified domain). The from-address
# must be one the provider has authorised. See ../.env.example for the full note.
LAPS_EMAIL_PROVIDER=
LAPS_EMAIL_API_KEY=
LAPS_EMAIL_FROM=
LAPS_EMAIL_FROM_NAME=LAPS
# Send budget — see ../.env.example.
LAPS_EMAIL_MIN_INTERVAL_SECONDS=60
LAPS_EMAIL_MAX_PER_ACCOUNT_PER_DAY=5
LAPS_EMAIL_MAX_PER_DAY=200

# ── Translation provider ──────────────────────────────────────────────────
# `mymemory` ships bio text to a free public API — see the LGPD note in
# ../.env.example before enabling it on real member data.
LAPS_TRANSLATE_PROVIDER=mymemory
LAPS_TRANSLATE_BASE_URL=
LAPS_TRANSLATE_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────
LAPS_RATE_AUTH_PER_MIN=10
LAPS_RATE_AUTH_BLOCK_SECONDS=60

# ── Runtime ───────────────────────────────────────────────────────────────
SERVER_PORT=8080

# Leave unset for local dev. `prod` enables the production overrides in
# application-prod.yml (proxy header handling, sslmode=require default,
# and a REQUIRED LAPS_CORS_ALLOWED_ORIGINS with no fallback).
SPRING_PROFILES_ACTIVE=

# Log levels. Keep JDBC at WARN outside of debugging sessions.
LOG_LEVEL_APP=INFO
LOG_LEVEL_JDBC=WARN
