DB_HOST=localhost
DB_PORT=3306
DB_NAME=lapsnew
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Must be at least 32 characters for HS256
LAPS_JWT_SECRET=your_jwt_secret_at_least_32_chars_here

# Bootstrap admin password (only used on first boot if the account has no password yet).
# Account email is configured in application.yml under laps.bootstrap.email.
LAPS_BOOTSTRAP_PASSWORD=replace_me_at_least_8_chars

SERVER_PORT=8080
